# Accepted-risk CVEs for this image, one per line:
#   CVE-ID exp:YYYY-MM-DD # reason
# `exp:` is a native Trivy feature - once the date passes, Trivy stops
# honoring the entry and the scan fails again, so these don't rot silently.
# Re-scan the real built image (scripts/podman-scan.sh in fleet-ops) before the
# expiry; if upstream has shipped the fixes, drop the lines instead of just
# pushing the date out.
#
# Not listed on purpose: the Go stdlib CVEs of the base image's gosu binary.
# This image's ENTRYPOINT replaces the base entrypoint that uses gosu, so the
# Dockerfile deletes it instead.

# Python packages bundled inside the google-cloud-cli apt package
# (/usr/lib/google-cloud-sdk/platform/bundledpythonunix), not anything we
# build. Fixed upstream, not yet rebuilt into the package.
CVE-2026-114613 exp:2026-11-26 # msgpack 1.1.2 -> 1.2.3
GHSA-6v7p-g79w-8964 exp:2026-11-26 # msgpack 1.1.2 -> 1.2.1
CVE-2026-97687 exp:2026-11-26 # urllib3 2.7.0 -> 2.8.0
CVE-2026-97689 exp:2026-11-26 # urllib3 2.7.0 -> 2.8.0
CVE-2025-47273 exp:2026-11-26 # setuptools 70.3.0 -> 78.1.1

# gcloud-crc32c, a Go binary shipped in the google-cloud-cli apt package
# (built with Go 1.27.2, fixed in 1.27.3).
CVE-2026-111943 exp:2026-11-26 # stdlib in gcloud-crc32c
